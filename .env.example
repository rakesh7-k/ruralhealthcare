# ============================================================
# SETHU — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.

# Server
PORT=3000
NODE_ENV=development

# Database
# For SQLite (default prototype mode):
DATABASE_PATH=./data/sethu.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/sethu

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRY=24h

# Client
VITE_API_URL=http://localhost:3000/api

# Demo Mode — pre-seeds database, enables role-switch login
DEMO_MODE=true
