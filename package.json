{
  "name": "sethu",
  "version": "0.1.0",
  "private": true,
  "description": "SETHU — Care Access + Care Continuity Platform for rural and underserved communities",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "db:init": "npm run db:init --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:reset": "npm run db:reset --workspace=server"
  },
  "devDependencies": {
    "@types/socket.io": "^3.0.1",
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
